APP_NAME=Buildify360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiwanaerp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true when the site is served over HTTPS. Production defaults to true when this is omitted.
SESSION_SECURE_COOKIE=

# Comma-separated browser origins allowed to call the API. Do not use * with credentials.
CORS_ALLOWED_ORIGINS="${APP_URL}"

# Reverse-proxy addresses, comma-separated. Leave empty unless a proxy sets X-Forwarded-*.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database
UPLOAD_MAX_KB=25600
UPLOAD_PHOTO_MAX_KB=10240

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Company switcher and platform company administration. Tenancy stays on either way.
FEATURE_MULTI_COMPANY=false

# Local CAD preview. auto tries ODA, then LibreDWG. Leave the ODA path empty unless that tool is licensed on this machine.
CAD_PREVIEW_DRIVER=auto
LIBREDWG_DWG2SVG=dwg2SVG
ODA_CONVERTER_BINARY=
ODA_CONVERTER_VERSION=ACAD2018
ODA_CONVERTER_FORMAT=PDF
CAD_PREVIEW_TIMEOUT=180

# Optional external DWG preview. Leave this off unless licensing and privacy review are complete.
# local | sharecad | auto. auto uses ShareCAD only when the local converter is unavailable.
# Commercial licensing/permission must be confirmed before production use.
DWG_PREVIEW_PROVIDER=local
SHARECAD_DWG_PREVIEW=false

FCM_PROJECT_ID=
FCM_CREDENTIALS=
FCM_WEB_API_KEY=
FCM_WEB_AUTH_DOMAIN=
FCM_MESSAGING_SENDER_ID=
FCM_WEB_APP_ID=
FCM_WEB_VAPID_KEY=
